# Kernel configurations for full DroidSpaces support for GKI
# Copyright (C) 2026 ravindu644 <droidcasts@protonmail.com>

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Networking (Enhanced NAT support)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- Below configs are optional but recommended ---

# UFW support
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Enable xattr, posix acl support on tmpfs
# For NixOS support
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ============================================================
# EXTRA (bukan bagian Droidspace) - fix "Unknown symbol (err -2)"
# untuk vendor .ko Xiaomi 15 (cfg80211, btpower, haptic AW86xxx,
# audio WCD/WSA/TFA codec).
#
# Root cause: GKI men-trim exported symbol yang gak dipakai
# in-tree module AOSP (CONFIG_TRIM_UNUSED_KSYMS). Vendor blob
# Xiaomi butuh symbol itu tapi udah ke-strip pas kamu self-build
# dari manifest AOSP murni -> insmod gagal -> HAL fallback ke
# vibration flat & audio rusak & boot lama karena deferred probe.
# ============================================================
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_UNUSED_SYMBOLS=y

# Jangan block .ko vendor yang disign pakai key Xiaomi sendiri
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# RFKILL builtin - dependency cfg80211.ko & btpower.ko
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y

# Input force-feedback builtin - dependency haptic vendor .ko
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_MISC=y

# ASoC core builtin - dependency audio codec vendor .ko
CONFIG_SND=y
CONFIG_SND_SOC=y
