# Kernel configurations for full DroidSpaces support for GKI
# Copyright (C) 2026 ravindu644 <droidcasts@protonmail.com>

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Networking (Enhanced NAT support)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- Below configs are optional but recommended ---

# UFW support
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Enable xattr, posix acl support on tmpfs
# For NixOS support
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ============================================================
# EXTRA (bukan bagian Droidspace) - fix "Unknown symbol (err -2)"
# untuk vendor .ko Xiaomi 15.
#
# PENTING: JANGAN paksa y/m untuk RFKILL/SND/INPUT dkk - itu bisa
# bentrok sama module_outs manifest Bazel GKI (lihat error:
# "Unable to find net/rfkill/rfkill.ko"). Cukup matiin symbol
# trimming saja, jangan ubah status builtin/module apapun.
# ============================================================
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_UNUSED_SYMBOLS=y

# Jangan block .ko vendor yang disign pakai key Xiaomi sendiri
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set

# Disable KUnit & test modules (Fix KMI symbol list violations)
CONFIG_KUNIT=n
CONFIG_RUNTIME_TESTING_MENU=n
CONFIG_NET_9P=n
